{
  "name": "@bemviver/api",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "db:preparar": "prisma migrate deploy && tsx --env-file=.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "studio": "prisma studio --port 5555"
  },
  "dependencies": {
    "@bemviver/shared": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
